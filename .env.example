# =============================================================================
# TEMPLAT KONFIGURASI KONEKSI frontend <-> backend
# =============================================================================
#
# Salin file ini menjadi `.env` di root repository, lalu ganti nilai <...>.
#
# File ini hanya berisi alamat yang menghubungkan portal dengan API, dan tidak
# ada rahasia di dalamnya, sehingga aman ikut repository.
#
# Semua nilai sensitif (APP_KEY, DB_PASSWORD, MAIL_PASSWORD) TIDAK ada di sini.
# Setelah `git clone` di server, Anda perlu:
#   1. menyalin file ini menjadi `.env` dan mengganti bagian <...>
#   2. membuat `backend/.env` sekali saja dengan nilai rahasia milik server
#      (panduan lengkap ada di CPANEL.md)
#
# CATATAN PENTING: `VITE_API_URL` dibaca browser dan DIBEKUKAN saat
# `npm run build`. Ubah dulu, baru build ulang frontend.
# =============================================================================

# =============================================================================
# ALAMAT
# =============================================================================

# Alamat API (dipakai backend untuk membuat tautan pada email).
APP_URL=https://api.domain-anda.sch.id

# Alamat portal yang dibuka pengguna di browser (dipakai backend untuk
# menautkan email lupa kata sandi dan peringatan masuk).
FRONTEND_URL=https://portal.domain-anda.sch.id

# Alamat API yang dipanggil browser (Vite).
VITE_API_URL=https://api.domain-anda.sch.id/api/v1

# =============================================================================
# KEAMANAN CORS
# =============================================================================
#
# Daftar origin yang boleh memanggil API lintas-domain, dipisah koma.
# WAJIB berisi alamat portal. Kosong berarti browser memblokir seluruh
# panggilan lintas-origin dan login akan gagal.
#
CORS_ALLOWED_ORIGINS=https://portal.domain-anda.sch.id

# =============================================================================
# FRONTEND
# =============================================================================

# Keluar otomatis setelah berapa menit tanpa aktivitas (bawaan 15).
VITE_SESSION_IDLE_MINUTES=15