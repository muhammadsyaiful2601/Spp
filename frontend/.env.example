# Backend must be running on the same port: php artisan serve  (default 8000)
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Sign the user out after this many idle minutes (default 15).
# A value that is not a positive number falls back to 15 rather than disabling
# the timeout entirely.
VITE_SESSION_IDLE_MINUTES=15
