# =============================================================================
# KONFIGURASI KONEKSI frontend <-> backend
# =============================================================================
#
# File ini HANYA berisi alamat dan pengaturan yang menghubungkan portal dengan
# API. Tidak ada rahasia di sini, jadi file ini boleh ikut repository dan
# ikut ter-clone di server.
#
# Semua rahasia (APP_KEY, password database, kunci SMTP) berada di
# `backend/.env` yang TIDAK ikut repository.
#
# ---------------------------------------------------------------------
# CARA PAKAI
# ---------------------------------------------------------------------
# Di server, setelah `git clone`, file ini adalah satu-satunya yang perlu
# diubah supaya portal dan API menyambung. Isi `backend/.env` sekali saja
# dengan nilai rahasia milik server.
#
# Caraenseigner ulang APP_KEY:
#   cd backend && php artisan key:generate
#
# ---------------------------------------------------------------------
# YANG PERLU DIUBAH SAAT HOSTING
# ---------------------------------------------------------------------
# Lima baris di bawah. Ganti dengan domain Anda sendiri.
#
# CATATAN: `VITE_API_URL` dibaca browser dan DIBEKUKAN saat `npm run build`.
# Ubah nilainya, lalu build ulang frontend. Mengubah file ini setelah build
# tidak mengubah bundle yang sudah jadi.
#
# =============================================================================
# FRONTEND
# =============================================================================
# ALAMAT
# =============================================================================

# Alamat API (dipakai backend untuk membuat tautan pada email).
APP_URL=http://localhost:8000

# Alamat portal yang dibuka pengguna di browser (dipakai backend untuk
# menautkan email lupa kata sandi dan peringatan masuk).
FRONTEND_URL=http://localhost:5173

# Alamat API yang dipanggil browser (Vite).
VITE_API_URL=http://127.0.0.1:8000/api/v1

# =============================================================================
# KEAMANAN CORS
# =============================================================================
#
# Daftar origin yang boleh memanggil API lintas-domain, dipisah koma.
# WAJIB berisi alamat portal. Kosong berarti browser memblokir seluruh
# panggilan lintas-origin, sehingga login gagal dengan pesan "Server tidak
# dapat dihubungi" padahal server berjalan baik.
#
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# FRONTEND
# =============================================================================

# Keluar otomatis setelah berapa menit tanpa aktivitas (bawaan 15).
VITE_SESSION_IDLE_MINUTES=15