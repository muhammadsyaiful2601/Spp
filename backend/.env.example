APP_NAME="Portal Keuangan Sekolah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# URL frontend (React SPA) — dipakai tautan pada email peringatan masuk.
# Produksi wajib diisi dengan alamat publik frontend; default hanya untuk dev.
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================================================
# Email (SMTP)
# ==========================================================================
# Tanpa konfigurasi di bawah, kode verifikasi TIDAK akan sampai ke pengguna:
# MAIL_MAILER=log hanya menulis ke storage/logs/laravel.log.
#
# Setelah mengisi, buktikan dengan:  php artisan mail:test alamat@email-anda
#
# MAIL_SCHEME hanya menerima dua nilai:
#   smtp   -> STARTTLS dengan port 587 (umum, disarankan)
#   smtps  -> TLS langsung, biasanya port 465
# Catatan: MAIL_ENCRYPTION tidak lagi dibaca sejak Laravel 7.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Contoh per penyedia (pilih satu, hapus sisanya) ------------------------
#
# Brevo (300 email/hari gratis):
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtp
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=<xsmtpib-xxxxxxxxx@smtp-brevo.com>
#   MAIL_PASSWORD=<kunci smtp>
#
# Gmail (WAJIB App Password, bukan password akun; aktifkan 2FA dulu):
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtp
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=587
#   MAIL_USERNAME=<email@gmail.com>
#   MAIL_PASSWORD=<app password 16 karakter>
#
# Hosting cPanel/server sendiri:
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtp
#   MAIL_HOST=mail.domain-sekolah.sch.id
#   MAIL_PORT=587
#   MAIL_USERNAME=portal@domain-sekolah.sch.id
#   MAIL_PASSWORD=<password email>
#
# CATATAN: MAIL_FROM_ADDRESS harus sudah diverifikasi di akun penyedia. Brevo
# dan Gmail akan menolak pengirim yang tidak dikenal (error 550/553), dan
# kode verifikasi akan hilang di spam.

# Mengembalikan kode verifikasi ke respons JSON, supaya alur bisa diuji tanpa
# membuka inbox.
#
# ⚠  JANGAN pernah bernilai true di server yang bisa dijangkau publik. Kode ini
#    adalah bukti kepemilikan akun; membocorkannya di respons API berarti
#    siapa pun bisa memverifikasi akun orang lain.
#    Nilai default adalah false di semua environment, termasuk staging.
EMAIL_VERIFICATION_EXPOSE_CODE=false

# Masa berlaku tautan bertanda tangan "akhiri sesi" di dalam email peringatan
# masuk, dalam jam. Setiap login berhasil mengirim email tersebut ke akun dengan
# email terverifikasi; kegagalan SMTP tidak membatalkan login.
LOGIN_ALERT_LINK_TTL_HOURS=24

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
